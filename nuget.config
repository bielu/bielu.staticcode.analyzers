<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- <clear/> drops any feeds inherited from user/machine-level NuGet.config so restore is
       reproducible: the same packages resolve on a contributor's machine and on CI. Every
       package pinned in Directory.Packages.props is published on nuget.org, so one feed
       is sufficient. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Source mapping resolves NU1507 and pins every package to a single known feed, so a
       package cannot be silently served by a different source than intended. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
