<Project>

    <Import Project="../version.props"/>

    <PropertyGroup>
        <Title>$(MSBuildProjectName)</Title>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <RunSettingsFilePath>$(MSBuildThisFileDirectory)../coverlet.runsettings</RunSettingsFilePath>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>bielu</Authors>
        <PackageOutputPath>$(MSBuildProjectDirectory)/../../dist</PackageOutputPath>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <!-- A published NuGet version is immutable, so license metadata lives here rather than in
             one csproj, where a new package could be packed without it. -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2026 Arkadiusz Biel</Copyright>
        <RepositoryUrl>https://github.com/bielu/bielu.staticcode.analyzers</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/bielu/bielu.staticcode.analyzers</PackageProjectUrl>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Source Link: stamps the commit into the package's repository metadata and the PDB.
             The SourceLink GitHub provider ships in the .NET SDK, so no PackageReference is needed.
             No snupkg: the analyzer package ships its DLL under analyzers/ rather than lib/
             (IncludeBuildOutput is false), so a symbol package would have nothing to index. -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <!-- Normalizes embedded paths so CI-produced packages are byte-reproducible. -->
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
        <!-- Rendered at 512px from icon.svg next to it. -->
        <None Include="$(MSBuildThisFileDirectory)../assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

</Project>
